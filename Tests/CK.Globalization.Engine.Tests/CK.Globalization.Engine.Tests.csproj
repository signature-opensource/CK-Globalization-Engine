<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CK.Testing.StObjEngine" Version="34.0.0--ci.2" />
    <PackageReference Include="CK.Testing.Nunit" Version="16.0.0--ci.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CK.Globalization.Engine\CK.Globalization.Engine.csproj" />
    <!-- [LocalePackage] attribute used by the in-test fixtures (the engine now selects on it). -->
    <ProjectReference Include="..\..\CK.Globalization.StObj\CK.Globalization.StObj.csproj" />
    <!-- Dedicated single-package fixture assembly added to FirstBinPath.Assemblies so [LocalePackage]
         attribute-driven discovery is exercised the way a real app scans a referenced package assembly. -->
    <ProjectReference Include="..\CK.Globalization.Engine.Tests.LocaleAttrFixture\CK.Globalization.Engine.Tests.LocaleAttrFixture.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="%24StObjGen\" />
  </ItemGroup>
  <ItemGroup>
    <!-- Test-only Res/locales contributed by SampleLocalePackage for the build-time merge.
         No repo-wide default glob embeds Res\, so this is required (kept explicit + self-contained). -->
    <EmbeddedResource Include="Res\**\*" />
    <!-- Res folders for validation-test packages (BadLocalePackage, OrphanKeyLocalePackage).
         Each package's source file lives in its own subfolder so [EmbeddedResourceType] resolves
         the correct Res/ path per type via CallerFilePath. -->
    <EmbeddedResource Include="BadLocale\Res\**\*" />
    <EmbeddedResource Include="OrphanKey\Res\**\*" />
    <EmbeddedResource Include="Sniff\Res\**\*" />
    <EmbeddedResource Include="SniffEs\Res\**\*" />
    <EmbeddedResource Include="Bogus\Res\**\*" />
    <EmbeddedResource Include="Plain\Res\**\*" />
  </ItemGroup>
</Project>
